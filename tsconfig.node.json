{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": false,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["electron.vite.config.ts", "vite.cli.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/cli/**/*", "src/renderer/src/lib/format.ts", "src/renderer/src/components/chat/describe.ts", "src/renderer/src/views/settings/schema.ts"]
}
