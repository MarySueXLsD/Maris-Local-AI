{
  "name": "maris",
  "productName": "Maris",
  "version": "0.5.1",
  "description": "Maris — a private, local AI assistant for Windows, macOS, Linux and Android: chat, computer agent with approvals, memory, web browsing, and image/video generation.",
  "main": "./out/main/index.js",
  "author": "MarySue",
  "homepage": "https://github.com/MarySueXLsD/Maris-Local-AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarySueXLsD/Maris-Local-AI.git"
  },
  "bugs": {
    "url": "https://github.com/MarySueXLsD/Maris-Local-AI/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-cli.cjs",
    "build:cli": "node scripts/build-cli.cjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"tests/*.test.ts\"",
    "e2e": "npm run build && node tests/e2e/smoke.mjs test-results/e2e-shots && node tests/e2e/code.mjs test-results/e2e-shots",
    "icons": "electron scripts/make-icons.cjs",
    "dist": "npm run build && electron-builder --win --x64 -c.directories.output=release/windows",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir -c.directories.output=release/windows",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 -c.directories.output=release/macos",
    "dist:linux": "npm run build && electron-builder --linux --x64 -c.directories.output=release/linux",
    "icons:platform": "python scripts/make-platform-icons.py",
    "mobile:build": "vite build -c vite.mobile.config.ts",
    "mobile:apk": "node scripts/build-apk.cjs",
    "dist:linux:win": "npm run build && electron-builder --linux tar.gz --x64 -c.directories.output=release/linux && python scripts/fix-linux-tar.py release/linux"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "7zip-bin": "^5.2.0",
    "diff": "^8.0.2",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.540.0",
    "playwright-core": "^1.65.0",
    "radix-ui": "^1.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.2",
    "uqr": "^0.1.3",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
